# Telegram bot token from @BotFather, e.g. 123456789:AAH...
TELEGRAM_BOT_TOKEN=

# Chat ID to send notifications to (your user ID, or a group/channel ID).
# Get yours by messaging your bot then visiting:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Interface to listen on. Leave blank to accept connections from other
# devices on your LAN (binds all interfaces), or use 127.0.0.1 to only
# accept local connections.
SMTP_HOST=

# Port to listen on. Ports below 1024 (e.g. 25) may require admin/root
# privileges. 2525 works out of the box on Windows without elevation.
SMTP_PORT=2525

# Max accepted message size in bytes (default 10 MB).
MAX_MESSAGE_SIZE=10485760
